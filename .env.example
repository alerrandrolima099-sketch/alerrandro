# ============================================================================
# WhatsApp SaaS - Variáveis de ambiente
# Copie este arquivo para ".env" na raiz do projeto e ajuste os valores.
# NUNCA commite o arquivo ".env" real com secrets reais.
# ============================================================================

NODE_ENV=development

# --- Banco de dados ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_saas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=whatsapp_saas

# --- Redis / Filas ---
REDIS_URL=redis://localhost:6379

# --- Autenticação (troque estes valores em produção!) ---
JWT_SECRET=troque-este-valor-para-um-segredo-forte-em-producao
JWT_REFRESH_SECRET=troque-este-valor-tambem-para-um-segredo-diferente
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Criptografia de credenciais sensíveis (Instance.providerConfig) ---
ENCRYPTION_KEY=troque-esta-chave-para-32-bytes-aleatorios

# --- Provedor de mensageria oficial ---
# MOCK (padrão - desenvolvimento sem credenciais) | WHATSAPP_CLOUD_API (produção)
MESSAGING_PROVIDER=MOCK

# Preencha os três abaixo apenas ao ativar WHATSAPP_CLOUD_API:
# URL do número na WhatsApp Business Cloud API (Meta), ex:
#   https://graph.facebook.com/v20.0/<PHONE_NUMBER_ID>
MESSAGING_API_URL=
# Token de acesso permanente do WhatsApp Business (Meta Business Manager)
MESSAGING_API_TOKEN=
# App Secret usado para validar a assinatura X-Hub-Signature-256 dos webhooks
WEBHOOK_SECRET=troque-este-valor-para-o-app-secret-do-provedor

# --- Portas e CORS ---
API_PORT=4000
WEB_PORT=3000
CORS_ORIGIN=http://localhost:3000

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Sessões / Automação ---
DEFAULT_SESSION_STEP_DURATION_SEC=60
